+  pad = {
+    file = function(convert, ctx)
+      local cell = Snacks.image.config.reset_cell
+      local stat = uv.fs_stat(convert.src)
+      local stamp = stat and (stat.mtime.sec .. "." .. stat.mtime.nsec) or "remote"
+      return convert:tmpfile(("%s.%s.%dx%d.png"):format(vim.fn.sha256(ctx.src):sub(1, 8), stamp, cell.width, cell.height))
