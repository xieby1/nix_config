+    cmd = function(step)
+      local cell = Snacks.image.config.reset_cell
+      local extent = ("%%[fx:ceil(w/%d)*%d]x%%[fx:ceil(h/%d)*%d]"):format(cell.width, cell.width, cell.height, cell.height)
+      -- Publish atomically: multiple Neovim sessions can share this cache.
+      step.tmp = step.file .. "." .. vim.fn.getpid() .. ".tmp.png"
+      return { cmd = "magick", args = { "{src}[0]", "+repage", "-background", "none", "-gravity", "NorthWest", "-extent", extent, step.tmp } }
+    end,
+    on_done = function(step)
+      if step.tmp then
