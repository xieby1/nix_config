@@ -0,0 +1,58 @@
+package git_commands
+
+import (
+	"os/exec"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/jesseduffield/lazygit/pkg/common"
+	"github.com/jesseduffield/lazygit/pkg/utils"
+	"github.com/stretchr/testify/assert"
+)
+
+func TestCommitCoAuthorTrailers(t *testing.T) {
+	dir := t.TempDir()
+	git := func(args ...string) string {
+		cmd := exec.Command("git", args...)
+		cmd.Dir = dir
+		cmd.Env = append(cmd.Environ(), "GIT_CONFIG_GLOBAL="+filepath.Join(dir, "no-config"), "GIT_CONFIG_NOSYSTEM=1")
+		out, err := cmd.CombinedOutput()
+		if !assert.NoError(t, err, string(out)) {
+			t.FailNow()
+		}
+		return string(out)
+	}
+	git("init", "-q")
+	loader := &CommitLoader{Common: common.NewDummyCommon()}
+	assert.Equal(t, prettyFormat, loader.commitPrettyFormat())
+	loader.UserConfig().Gui.CommitCoAuthorLongLength = 12
+	pool := &utils.StringPool{}
+	special := "special\x001234\x00Test\x00test@example.com\x00\x00>\x00\x00subject\x00with NUL\x00Jane Doe <jane@example.com>"
+	parsed := loader.extractCommitFromLine(pool, special, false)
+	assert.Equal(t, "subject\x00with NUL", parsed.Name)
+	assert.Equal(t, "Jane Doe", parsed.CoAuthors)
+	for _, s := range []struct {
+		name    string
+		message string
+		names   []string
+	}{
+		{"none", "subject", nil},
+		{"one", "subject\n\nCo-authored-by: Jane Doe <jane@example.com>", []string{"Jane Doe"}},
+		{"multiple and case insensitive", "subject\n\nCo-Authored-By: Jane, Doe <jane@example.com>\nCo-authored-by: 张三 <zhang@example.com>\nGenerated-By: pi", []string{"Jane, Doe", "张三"}},
+		{"folded", "subject\n\nCo-authored-by: Jane\n Doe <jane@example.com>", []string{"Jane Doe"}},
+		{"not a trailer", "subject\n\nCo-authored-by: Jane Doe <jane@example.com>\n\nThis is prose.", nil},
+	} {
+		t.Run(s.name, func(t *testing.T) {
+			git("-c", "user.name=Test", "-c", "user.email=test@example.com", "-c", "commit.gpgSign=false", "commit", "--allow-empty", "-qm", s.message)
+			out := strings.TrimSuffix(git("log", "-1", loader.commitPrettyFormat()), "\n")
+			assert.NotContains(t, out, "\n")
+			commit := loader.extractCommitFromLine(pool, strings.TrimPrefix(out, "+"), false)
+			if !assert.NotNil(t, commit) {
+				t.FailNow()
+			}
+			assert.Equal(t, "subject", commit.Name)
+			assert.Equal(t, strings.Join(s.names, ", "), commit.CoAuthors)
+		})
+	}
+}
