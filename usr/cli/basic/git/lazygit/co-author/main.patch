diff --git a/pkg/gui/presentation/commits_coauthor_test.go b/pkg/gui/presentation/commits_coauthor_test.go
new file mode 100644
index 0000000..831e052
--- /dev/null
+++ b/pkg/gui/presentation/commits_coauthor_test.go
@@ -0,0 +1,94 @@
+package presentation
+
+import (
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/gookit/color"
+	"github.com/jesseduffield/generics/set"
+	"github.com/jesseduffield/lazygit/pkg/commands/git_commands"
+	"github.com/jesseduffield/lazygit/pkg/commands/models"
+	"github.com/jesseduffield/lazygit/pkg/common"
+	"github.com/jesseduffield/lazygit/pkg/gui/presentation/authors"
+	"github.com/jesseduffield/lazygit/pkg/gui/presentation/graph"
+	"github.com/jesseduffield/lazygit/pkg/gui/style"
+	"github.com/jesseduffield/lazygit/pkg/utils"
+	"github.com/stretchr/testify/assert"
+	"github.com/xo/terminfo"
+)
+
+func TestCommitCoAuthorColors(t *testing.T) {
+	oldColorLevel := color.ForceSetColorLevel(terminfo.ColorLevelMillions)
+	defer color.ForceSetColorLevel(oldColorLevel)
+	defer authors.SetCustomAuthors(nil)
+	for _, names := range [][]string{{"Jane Doe"}, {"Jane Doe", "John Doe"}} {
+		joined := strings.Join(names, ", ")
+		authors.SetCustomAuthors(map[string]string{"xieby1": "red", joined: "blue"})
+		cmn := common.NewDummyCommon()
+		cmn.UserConfig().Gui.CommitCoAuthorLongLength = 24
+		pool := &utils.StringPool{}
+		commits := []*models.Commit{models.NewCommit(pool, models.NewCommitOpts{
+			Hash: "abcdef123", Name: "subject", AuthorName: "xieby1", CoAuthors: joined,
+		})}
+		for _, expanded := range []bool{false, true} {
+			cols := GetCommitListDisplayStrings(cmn, commits, nil, "main", false, expanded,
+				set.New[string](), "", "", "2006-01-02", "15:04", time.Now(), false,
+				nil, 0, 1, false, graph.BoxDrawingSymbols, git_commands.NewNullBisectInfo())[0]
+			if expanded {
+				assert.Equal(t, style.FgBlue.Sprint(utils.WithPadding(joined, 24, utils.AlignLeft)), cols[len(cols)-2])
+			} else {
+				assert.Equal(t, style.FgRed.Sprint("xi")+style.FgBlue.Sprint("&"), cols[len(cols)-2])
+			}
+		}
+	}
+}
+
+func TestCommitCoAuthorDisplay(t *testing.T) {
+	for _, s := range []struct {
+		name              string
+		width             int
+		expanded          bool
+		author            string
+		coAuthors         []string
+		expectedAuthor    string
+		expectedCoAuthors string
+	}{
+		{"off", 0, false, "xieby1", []string{"Jane Doe"}, "xi", ""},
+		{"off expanded", 0, true, "xieby1", []string{"Jane Doe"}, "xieby1", ""},
+		{"indicator", 12, false, "xieby1", []string{"Jane Doe"}, "xi&", ""},
+		{"blank indicator", 12, false, "xieby1", nil, "xi ", ""},
+		{"multiple indicator", 12, false, "xieby1", []string{"Jane Doe", "John Doe"}, "xi&", ""},
+		{"expanded name", 12, true, "xieby1", []string{"Jane Doe"}, "xieby1", "Jane Doe    "},
+		{"expanded blank", 12, true, "xieby1", nil, "xieby1", "            "},
+		{"expanded multiple", 12, true, "xieby1", []string{"Jane Doe", "John Doe"}, "xieby1", "Jane Doe, J…"},
+		{"unicode width", 5, true, "xieby1", []string{"张三李四"}, "xieby1", "张三…"},
+		{"one cell width", 1, true, "xieby1", []string{"Jane Doe"}, "xieby1", "."},
+		{"two cells are not initials", 2, true, "xieby1", []string{"Jane Doe"}, "xieby1", ".."},
+		{"short author", 12, false, "X", []string{"Jane Doe"}, "X&", ""},
+	} {
+		t.Run(s.name, func(t *testing.T) {
+			cmn := common.NewDummyCommon()
+			cmn.UserConfig().Gui.CommitCoAuthorLongLength = s.width
+			cmn.UserConfig().Gui.CommitAuthorLongLength = 6
+			pool := &utils.StringPool{}
+			commits := []*models.Commit{models.NewCommit(pool, models.NewCommitOpts{
+				Hash: "abcdef123", Name: "subject", AuthorName: s.author, CoAuthors: strings.Join(s.coAuthors, ", "),
+			})}
+			cols := GetCommitListDisplayStrings(cmn, commits, nil, "main", false, s.expanded,
+				set.New[string](), "", "", "2006-01-02", "15:04", time.Now(), false,
+				nil, 0, 1, false, graph.BoxDrawingSymbols, git_commands.NewNullBisectInfo())[0]
+			authorIdx := len(cols) - 2
+			if s.width > 0 && s.expanded {
+				authorIdx--
+				assert.Equal(t, s.expectedCoAuthors, utils.Decolorise(cols[authorIdx+1]))
+				assert.Equal(t, s.width, utils.StringWidth(utils.Decolorise(cols[authorIdx+1])))
+			}
+			assert.Equal(t, s.expectedAuthor, utils.Decolorise(cols[authorIdx]))
+			if !s.expanded {
+				lines, _ := utils.RenderDisplayStrings([][]string{cols}, nil)
+				assert.True(t, strings.HasSuffix(utils.Decolorise(lines[0]), s.expectedAuthor+" subject"), lines[0])
+			}
+		})
+	}
+}
