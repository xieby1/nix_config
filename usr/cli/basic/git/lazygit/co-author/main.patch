@@ -623,3 +638,10 @@ func (self *CommitLoader) getLogCmd(opts GetCommitsOptions) *oscommands.CmdObj {
 }
 
 const prettyFormat = `--pretty=format:+%H%x00%at%x00%aN%x00%ae%x00%P%x00%m%x00%D%x00%s`
+
+func (self *CommitLoader) commitPrettyFormat() string {
+	if self.UserConfig().Gui.CommitCoAuthorLongLength > 0 {
