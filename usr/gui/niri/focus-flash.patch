+                .count();
+            let action: niri_ipc::Action = serde_json::from_str(r#"{"AnimateWindow":{}}"#).unwrap();
+            f.niri_state().do_action(action.into(), false);
+            let peak = render_focus_flash_tile(&mut f);
+            let width = (200. * scale) as usize;
+            let center = ((width / 2) * width + width / 2) * 4;
+            let edge = ((width / 2) * width + (6. * scale) as usize) * 4;
+            assert_eq!(
+                &peak[center..center + 4],
+                &before[center..center + 4],
+                "no tint: {mode}, {scale}"
+            );
+            assert!(peak[edge + 2] < before[edge + 2], "inset: {mode}, {scale}");
+            set_time(f.niri(), Duration::from_millis(100));
+            f.niri().advance_animations();
+            let middle = render_focus_flash_tile(&mut f);
+            assert!(
+                middle[edge + 2] > peak[edge + 2],
