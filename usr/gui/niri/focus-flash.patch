+#[derive(knuffel::DecodeScalar, Debug, Clone, Copy, PartialEq, Eq)]
+pub enum FocusEffect {
+    Flash,
+    Shrink,
+}
+
+/// A transient focus indicator, also available through `animate-window`.
+#[derive(Debug, Clone, Copy, PartialEq)]
+pub struct WindowFocusAnim {
+    pub anim: Animation,
+    pub on_focus: bool,
+    pub effect: FocusEffect,
+    pub color: Color,
+    pub scale: f64,
+}
+
+impl Default for WindowFocusAnim {
+    fn default() -> Self {
+        Self {
+            anim: Animation {
+                off: false,
+                kind: Kind::Easing(EasingParams {
+                    duration_ms: 180,
+                    curve: Curve::EaseOutCubic,
+                }),
+            },
+            on_focus: false,
+            effect: FocusEffect::Flash,
+            color: Color::from_rgba8_unpremul(255, 255, 255, 38),
+            scale: 0.98,
+        }
+    }
+}
+
+impl<S: knuffel::traits::ErrorSpan> knuffel::Decode<S> for WindowFocusAnim {
+    fn decode_node(
+        node: &knuffel::ast::SpannedNode<S>,
+        ctx: &mut knuffel::decode::Context<S>,
+    ) -> Result<Self, DecodeError<S>> {
+        let mut rv = Self::default();
+        rv.anim = Animation::decode_node(node, ctx, rv.anim, |child, ctx| {
+            match &**child.node_name {
+                "on-focus" => rv.on_focus = crate::utils::Flag::decode_node(child, ctx)?.0,
+                "effect" => rv.effect = parse_arg_node("effect", child, ctx)?,
+                "color" => rv.color = Color::decode_node(child, ctx)?,
+                "scale" => {
+                    let scale: FloatOrInt<0, 1> = parse_arg_node("scale", child, ctx)?;
+                    if scale.0 <= 0. {
+                        ctx.emit_error(DecodeError::conversion(
+                            child,
+                            "scale must be greater than 0 and at most 1",
+                        ));
+                    }
+                    rv.scale = scale.0;
+                }
+                _ => return Ok(false),
+            }
+            Ok(true)
+        })?;
+        Ok(rv)
+    }
+}
+
