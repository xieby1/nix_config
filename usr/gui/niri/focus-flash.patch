+fn render_focus_flash_tile(f: &mut Fixture) -> Vec<u8> {
+    use crate::render_helpers::xray::XrayPos;
+    use crate::render_helpers::{render_to_vec, RenderCtx, RenderTarget};
+    use smithay::backend::allocator::Fourcc;
+    use smithay::utils::{Scale, Transform};
+
+    let state = f.niri_state();
+    state.niri.layout.update_render_elements(None);
+    let tile = state
+        .niri
+        .layout
+        .active_workspace()
+        .unwrap()
+        .tiles()
+        .find(|tile| tile.window().is_focused())
+        .unwrap();
+    state
+        .backend
+        .headless()
+        .with_primary_renderer(|renderer| {
+            let mut elements = Vec::new();
+            let scale = tile.scale();
+            let location = Point::from((0., 0.)) - tile.window_loc();
+            tile.render(
+                RenderCtx {
+                    renderer,
+                    target: RenderTarget::Output,
+                    xray: None,
+                },
+                location,
+                XrayPos::new(location, 1.),
+                false,
+                &mut |elem| elements.push(elem),
+            );
+            render_to_vec(
+                renderer,
+                Size::from((200., 200.)).to_physical_precise_round(scale),
+                Scale::from(scale),
+                Transform::Normal,
+                Fourcc::Abgr8888,
+                elements.into_iter().rev(),
+            )
+            .unwrap()
+        })
+        .unwrap()
+}
