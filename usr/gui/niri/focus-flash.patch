+    f.double_roundtrip(id);
+    f.niri_complete_animations();
+    set_time(f.niri(), Duration::ZERO);
+    (f, id, a, b)
+}
+
+fn flash_window(f: &mut Fixture) {
+    let action = serde_json::from_str::<niri_ipc::Action>(r#"{"FlashWindow":{}}"#).unwrap();
+    f.niri_state().do_action(action.into(), false);
+}
+
+fn flashing_windows(niri: &Niri) -> Vec<u64> {
+    let mut ids: Vec<_> = niri
+        .layout
+        .workspaces()
+        .flat_map(|(_, _, ws)| ws.tiles())
+        .filter(|tile| tile.are_animations_ongoing())
+        .map(|tile| tile.window().id().get())
+        .collect();
+    ids.sort_unstable();
+    ids
+}
+
+#[test]
+fn focus_flash_manual_restarts_and_finishes_without_moving_windows() {
+    let (mut f, _, _, _) = focus_flash_fixture("");
+    let geometry = format_tiles(f.niri());
+    assert!(flashing_windows(f.niri()).is_empty());
+    flash_window(&mut f);
+    assert_eq!(flashing_windows(f.niri()).len(), 1);
+    assert!(f.niri().layout.are_animations_ongoing(None));
+
+    set_time(f.niri(), Duration::from_millis(100));
+    flash_window(&mut f);
+    set_time(f.niri(), Duration::from_millis(200));
+    f.niri().advance_animations();
+    assert_eq!(flashing_windows(f.niri()).len(), 1);
+    assert_eq!(format_tiles(f.niri()), geometry);
+
+    set_time(f.niri(), Duration::from_millis(281));
+    f.niri().advance_animations();
+    assert!(flashing_windows(f.niri()).is_empty());
+    assert!(!f.niri().layout.are_animations_ongoing(None));
+    assert_eq!(format_tiles(f.niri()), geometry);
+}
