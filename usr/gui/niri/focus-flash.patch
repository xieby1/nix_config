+/// A transient content highlight, also available through the `flash-window` action.
+#[derive(Debug, Clone, Copy, PartialEq)]
+pub struct WindowFocusFlashAnim {
+    pub anim: Animation,
+    pub on_focus: bool,
+    pub color: Color,
+}
+
+impl Default for WindowFocusFlashAnim {
+    fn default() -> Self {
+        Self {
+            anim: Animation {
+                off: false,
+                kind: Kind::Easing(EasingParams {
+                    duration_ms: 180,
+                    curve: Curve::EaseOutCubic,
+                }),
+            },
+            on_focus: false,
+            color: Color::from_rgba8_unpremul(255, 255, 255, 38),
+        }
+    }
+}
+
+impl<S: knuffel::traits::ErrorSpan> knuffel::Decode<S> for WindowFocusFlashAnim {
+    fn decode_node(
+        node: &knuffel::ast::SpannedNode<S>,
+        ctx: &mut knuffel::decode::Context<S>,
+    ) -> Result<Self, DecodeError<S>> {
+        let mut rv = Self::default();
+        rv.anim = Animation::decode_node(node, ctx, rv.anim, |child, ctx| {
+            match &**child.node_name {
+                "on-focus" => rv.on_focus = crate::utils::Flag::decode_node(child, ctx)?.0,
+                "color" => rv.color = Color::decode_node(child, ctx)?,
+                _ => return Ok(false),
+            }
+            Ok(true)
+        })?;
+        Ok(rv)
+    }
+}
+
