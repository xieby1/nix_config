+#[test]
+fn egl_focus_shrink_composes_with_open_resize_and_opacity() {
+    for resize in [false, true] {
+        let (mut f, client, _, surface) = focus_flash_fixture(
+            r#"
+            animations {
+                window-focus { effect "shrink"; scale 0.9; }
+                window-open { duration-ms 1000; curve "linear"; }
+                window-resize { duration-ms 1000; curve "linear"; }
+            }
+        "#,
+        );
+        f.niri_state().backend.headless().add_renderer().unwrap();
+        f.client(client).attach_shm_buffer(&surface, 0xff0000ff);
+        f.client(client).window(&surface).commit();
+        f.double_roundtrip(client);
+        f.niri_complete_animations();
+        set_time(f.niri(), Duration::ZERO);
+        if resize {
+            f.niri()
+                .layout
+                .set_window_width(None, SizeChange::AdjustFixed(100));
+            f.double_roundtrip(client);
+            let window = f.client(client).window(&surface);
+            window.set_size(300, 200);
+            window.ack_last_and_commit();
+            f.double_roundtrip(client);
+        } else {
+            let tile = f
+                .niri()
+                .layout
+                .active_workspace_mut()
+                .unwrap()
+                .tiles_mut()
+                .find(|tile| tile.window().is_focused())
+                .unwrap();
+            tile.start_open_animation();
+            tile.animate_alpha(
+                1.,
+                0.5,
+                niri_config::Animation {
+                    off: false,
+                    kind: Kind::Easing(EasingParams {
+                        duration_ms: 1000,
+                        curve: Curve::Linear,
+                    }),
+                },
+            );
+        }
+        set_time(f.niri(), Duration::from_millis(100));
+        f.niri().advance_animations();
+        let geometry = format_tiles(f.niri());
+        let before = render_focus_flash_tile(&mut f);
+        let window = f.niri().layout.focus().unwrap().window.clone();
+        f.niri().layout.animate_window(Some(&window));
+        let shrunk = render_focus_flash_tile(&mut f);
+        let blue = |pixels: &[u8]| pixels.chunks_exact(4).map(|p| u64::from(p[2])).sum::<u64>();
+        assert!(
+            blue(&before) > 0,
+            "resize={resize}, geometry={geometry}, center={:?}",
+            &before[(100 * 200 + 100) * 4..(100 * 200 + 100) * 4 + 4]
+        );
+        assert!(blue(&shrunk) < blue(&before), "resize={resize}");
+        assert_eq!(format_tiles(f.niri()), geometry);
+        f.niri().layout.animate_window(None);
+        assert_eq!(render_focus_flash_tile(&mut f), before);
+    }
+}
