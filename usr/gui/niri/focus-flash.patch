+#[test]
+fn egl_focus_flash_renders_fades_and_preserves_rounded_corners() {
+    for state in ["", "open-floating true;", "open-fullscreen true;"] {
+        for scale in [1., 1.5, 2.] {
+            let config = format!(
+                "window-rule {{ geometry-corner-radius 32; clip-to-geometry true; {state} }}",
+            );
+            let (mut f, client, _, surface) = focus_flash_fixture(&config);
+            let window = f.client(client).window(&surface);
+            window.attach_solid_color_buffer([0, 0, 0, u32::MAX]);
+            window.commit();
+            f.double_roundtrip(client);
+            let output = f.niri_output(1);
+            output.change_current_state(
+                None,
+                None,
+                Some(smithay::output::Scale::Fractional(scale)),
+                None,
+            );
+            f.niri().layout.update_output_size(&output);
+            f.double_roundtrip(client);
+            f.niri_complete_animations();
+            set_time(f.niri(), Duration::ZERO);
+            f.niri_state().backend.headless().add_renderer().unwrap();
+            let before = render_focus_flash_tile(&mut f);
+            flash_window(&mut f);
+            let peak = render_focus_flash_tile(&mut f);
+            let width = (200. * scale) as usize;
+            let center = ((width / 2) * width + width / 2) * 4;
+            assert!(
+                peak[center] > before[center],
+                "{state}, scale {scale}: before={:?}, peak={:?}, flashing={:?}",
+                &before[center..center + 4],
+                &peak[center..center + 4],
+                flashing_windows(f.niri())
+            );
+            if state == "open-fullscreen true;" {
+                assert!(peak[0] > before[0]);
+            } else {
+                assert_eq!(&peak[..4], &before[..4]);
+            }
+
+            set_time(f.niri(), Duration::from_millis(90));
+            f.niri().advance_animations();
+            let middle = render_focus_flash_tile(&mut f);
+            assert!(before[center] < middle[center] && middle[center] < peak[center]);
+            set_time(f.niri(), Duration::from_millis(181));
+            f.niri().advance_animations();
+            assert_eq!(render_focus_flash_tile(&mut f), before);
+        }
+    }
+}
