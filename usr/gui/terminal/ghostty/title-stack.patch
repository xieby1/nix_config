 const log = std.log.scoped(.io_handler);
 
+const TitleStack = struct {
+    const max_depth = 10;
+    const max_title_len = 255;
+
+    const Entry = struct {
+        value: [max_title_len]u8 = undefined,
+        len: usize = 0,
+        initialized: bool = false,
+
+        fn set(self: *Entry, title: []const u8) void {
+            std.debug.assert(title.len <= max_title_len);
+            @memcpy(self.value[0..title.len], title);
+            self.len = title.len;
+            self.initialized = true;
+        }
+
+        fn get(self: *const Entry) ?[]const u8 {
+            if (!self.initialized) return null;
+            return self.value[0..self.len];
+        }
+    };
+
+    entries: [max_depth]Entry = @splat(.{}),
+    depth: usize = 0,
+
+    fn push(self: *TitleStack, title: []const u8, index: u16) void {
+        if (index != 0) {
+            const slot = @as(usize, index - 1) % max_depth;
+            self.entries[slot].set(title);
+            return;
+        }
+
+        if (self.depth == max_depth) {
+            std.mem.copyForwards(Entry, self.entries[0 .. max_depth - 1], self.entries[1..]);
+            self.depth -= 1;
+        }
+        self.entries[self.depth].set(title);
+        self.depth += 1;
+    }
+
+    fn pop(self: *TitleStack, index: u16) ?[]const u8 {
+        if (index != 0) {
+            const slot = @as(usize, index - 1) % max_depth;
+            return self.entries[slot].get();
+        }
+
+        if (self.depth == 0) return null;
+        self.depth -= 1;
+        return self.entries[self.depth].get();
+    }
+};
+
+const TitleStacks = struct {
+    primary: TitleStack = .{},
+    alternate: TitleStack = .{},
+
+    fn active(self: *TitleStacks, key: terminal.ScreenSet.Key) *TitleStack {
+        return switch (key) {
+            .primary => &self.primary,
+            .alternate => &self.alternate,
+        };
+    }
+};
