diff --git a/crates/dav/src/base_path.rs b/crates/dav/src/base_path.rs
new file mode 100644
index 0000000..fcb6844
--- /dev/null
+++ b/crates/dav/src/base_path.rs
@@ -0,0 +1,39 @@
+use serde::{Deserialize, Serialize};
+
+/// A normalized, literal URL path at which the application is mounted.
+#[derive(Clone, Debug, Default, Deserialize, Serialize)]
+#[serde(try_from = "String")]
+pub struct BasePath(String);
+
+impl TryFrom<String> for BasePath {
+    type Error = &'static str;
+
+    fn try_from(value: String) -> Result<Self, Self::Error> {
+        if value.is_empty() || value == "/" {
+            return Ok(Self::default());
+        }
+        if let Some(path) = value.strip_prefix('/')
+            && path.split('/').all(|segment| {
+                !matches!(segment, "" | "." | "..")
+                    && segment
+                        .bytes()
+                        .all(|b| b.is_ascii_alphanumeric() || b"-._~".contains(&b))
+            })
+        {
+            return Ok(Self(value));
+        }
+        Err("base_path must be an absolute path of literal URL segments without a trailing slash")
+    }
+}
+
+impl BasePath {
+    #[must_use]
+    pub fn as_str(&self) -> &str {
+        &self.0
+    }
+
+    #[must_use]
+    pub fn url(&self, path: &str) -> String {
+        format!("{}{path}", self.0)
+    }
+}
